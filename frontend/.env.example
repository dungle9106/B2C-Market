# Backend URL when the frontend is deployed apart from it (Vercel / Netlify). Leave empty in development
# (Vite proxies /api and /ws to localhost:8080).
VITE_API_BASE_URL=https://shoppi-backend.onrender.com/api
# Optional: WebSocket URL if it differs from the API host (default: derived from VITE_API_BASE_URL)
# VITE_WS_URL=wss://shoppi-backend.onrender.com/ws
